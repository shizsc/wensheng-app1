{
  "name": "course-schedule-app",
  "version": "1.3.1",
  "description": "一款简洁实用的课程表手机 Web APP，支持 Excel 导入课程数据、周视图课表、今日课程提醒等功能。",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/js/**/*.test.js\" \"tests/js/**/*.test.mjs\"",
    "test:js": "node --test \"tests/js/**/*.test.js\" \"tests/js/**/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests/py -v",
    "test:all": "node --test \"tests/js/**/*.test.js\" \"tests/js/**/*.test.mjs\" && python -m unittest discover -s tests/py -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1"
  }
}
